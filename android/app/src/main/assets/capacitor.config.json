{
	"appId": "io.github.joeyf116.fretboard",
	"appName": "Fretboard Practice",
	"webDir": "dist",
	"backgroundColor": "#12151b",
	"ios": {
		"contentInset": "never",
		"backgroundColor": "#12151b"
	},
	"android": {
		"backgroundColor": "#12151b"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 600,
			"launchAutoHide": true,
			"backgroundColor": "#12151b",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#12151b",
			"overlaysWebView": true
		}
	}
}
